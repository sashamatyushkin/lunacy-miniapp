# Public API origin. Leave empty in development: the Vite dev server proxies
# /api to Fastify, so the Mini App and the API share one origin (and one tunnel).
VITE_API_URL=

# Used to build referral deep links: https://t.me/<BOT>/<SHORTNAME>?startapp=ref_xxxx
VITE_BOT_USERNAME=lunacy_shop_bot
VITE_APP_SHORTNAME=shop
