# ---------- database ----------
POSTGRES_USER=lunacy
POSTGRES_PASSWORD=lunacy
POSTGRES_DB=lunacy
DATABASE_URL=postgresql://lunacy:lunacy@localhost:5432/lunacy?schema=public

# ---------- api ----------
PORT=3001
NODE_ENV=development
# comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# ---------- telegram ----------
# @BotFather -> /newbot
BOT_TOKEN=
# public https url of the mini app (ngrok / cloudflared / prod domain)
WEBAPP_URL=https://your-tunnel.example.dev
# public https url of the api (used for the bot webhook)
API_PUBLIC_URL=https://your-api.example.dev
# random string, sent by telegram in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=change-me
# how long an initData signature stays valid, seconds
INITDATA_TTL=86400

# ---------- auth ----------
# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=7d

# ---------- payments ----------
# XTR = Telegram Stars (no provider needed). Set a provider token for fiat (RUB).
PAYMENT_CURRENCY=XTR
PAYMENT_PROVIDER_TOKEN=
# how many rubles equal 1 star, used only when PAYMENT_CURRENCY=XTR
RUB_PER_STAR=2

# ---------- web (apps/web/.env) ----------
VITE_API_URL=http://localhost:3001
